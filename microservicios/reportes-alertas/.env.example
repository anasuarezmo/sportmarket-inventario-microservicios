# Reportes y Alertas (copiar a .env; .env NO se sube a GitHub)
PORT=5007
INTERNAL_TOKEN=cambiar
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reportes_db
DB_USER=reportes_user
DB_PASSWORD=dev_password
# Servicios que Reportes consulta (RNF18: espera de 3 s y hasta 3 reintentos)
URL_INVENTARIO=http://localhost:3004
URL_CATALOGO=http://localhost:3003
TIMEOUT_SEG=3
REINTENTOS=3
# Los informes se reutilizan este tiempo (segundos) en un cache en memoria. 0 = sin cache
CACHE_TTL_SEG=30
