# Copiar como .env en cada servicio y completar. NUNCA subir el .env real.

# --- Seguridad (mismo valor en Gateway y Usuarios) ---
JWT_SECRET=cambiar_por_un_secreto_largo
JWT_EXPIRES_MINUTES=60
INTERNAL_TOKEN=cambiar_por_otro_secreto

# --- Direcciones de los servicios (desarrollo local) ---
URL_USUARIOS=http://localhost:5001
URL_BODEGAS=http://localhost:5002
URL_CATALOGO=http://localhost:3003
URL_INVENTARIO=http://localhost:3004
URL_COMPRAS=http://localhost:8005
URL_DEVOLUCIONES=http://localhost:5006
URL_REPORTES=http://localhost:5007

# --- Base de datos (ejemplo para un servicio) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=catalogo_db
DB_USER=catalogo_user
DB_PASSWORD=cambiarMYSQL_ROOT_PASSWORD=cambiar
