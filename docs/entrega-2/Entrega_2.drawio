        <mxCell id="inv_e4" edge="1" parent="1" source="inv_saldo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;dashed=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;fontColor=#6a4f87;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" target="inv_mov" value="mismo producto y bodega (sin FK)">
          <mxGeometry relative="1" x="-0.1055" y="-15" as="geometry">
            <mxPoint x="-15" y="15" as="offset" />
