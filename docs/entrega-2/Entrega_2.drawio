        <mxCell id="cat_e5" edge="1" parent="1" source="cat_categoria" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" target="cat_producto" value="clasifica">
          <mxGeometry relative="1" x="-0.1111" y="-10" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cat_t6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Ejemplo de jerarquía&lt;/b&gt;&lt;br&gt;Balones (categoría principal)&lt;br&gt;&amp;nbsp;&amp;nbsp;└ Fútbol (subcategoría: categoria_padre_id = Balones)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└ Balón de fútbol N°5 (producto: categoria_id = Fútbol)" vertex="1">
          <mxGeometry height="110" width="560" x="780" y="120" as="geometry" />
        </mxCell>
        <mxCell id="cat_t7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Cardinalidad&lt;/b&gt;&lt;br&gt;Una categoría tiene cero o muchos productos; cada producto pertenece a una categoría. Una categoría tiene cero o una categoría padre (las principales no tienen) y cero o muchas subcategorías." vertex="1">
          <mxGeometry height="100" width="560" x="780" y="260" as="geometry" />
        </mxCell>
        <mxCell id="cat_t8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;&quot;producto_activo&quot; y &quot;categoria_activa&quot; permiten la baja lógica (RF01, RF02).&lt;br&gt;proveedor_principal_id es solo una referencia informativa. La relación completa proveedor ↔ producto vive en Compras (producto_proveedor).&lt;br&gt;&lt;b&gt;Limitación conocida (RF12):&lt;/b&gt; el filtro por proveedor usa solo el proveedor principal; un producto con varios proveedores no aparece al filtrar por el secundario. Se acepta en esta entrega; el filtro completo se resolvería consultando Compras." vertex="1">
          <mxGeometry height="200" width="560" x="780" y="400" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
