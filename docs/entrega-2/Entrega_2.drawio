<mxfile host="app.diagrams.net" pages="9">
  <diagram name="0 Visión general" id="eBm6zPAr6quyvKYfWAgE">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gen_t1" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" value="Modelo de datos por microservicio · SportMarket S.A.S." vertex="1">
          <mxGeometry height="30" width="1500" x="20" y="15" as="geometry" />
        </mxCell>
        <mxCell id="gen_t2" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;" value="&lt;b&gt;PK&lt;/b&gt; llave primaria &amp;nbsp;·&amp;nbsp; &lt;b&gt;FK&lt;/b&gt; llave foránea (dentro de la misma BD) &amp;nbsp;·&amp;nbsp; &lt;b&gt;UK&lt;/b&gt; valor único &amp;nbsp;·&amp;nbsp; &lt;b&gt;&lt;font color=&quot;#6a4f87&quot;&gt;REF&lt;/font&gt;&lt;/b&gt; identificador de otro servicio (sin llave foránea)" vertex="1">
          <mxGeometry height="24" width="1500" x="20" y="48" as="geometry" />
        </mxCell>
        <mxCell id="gen_t3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#666666;fillColor=#ffffff;spacing=8;fontSize=12;" value="&lt;b&gt;Servicios, bases de datos y tablas&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th align=&quot;left&quot;&gt;Servicio&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Framework&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Base de datos&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Tablas&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Página&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Usuarios y Autenticación&lt;/td&gt;&lt;td&gt;Flask&lt;/td&gt;&lt;td&gt;usuarios_db&lt;/td&gt;&lt;td&gt;rol, usuario, token_recuperacion&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bodegas&lt;/td&gt;&lt;td&gt;Flask&lt;/td&gt;&lt;td&gt;bodegas_db&lt;/td&gt;&lt;td&gt;bodega, ubicacion&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Catálogo&lt;/td&gt;&lt;td&gt;Express&lt;/td&gt;&lt;td&gt;catalogo_db&lt;/td&gt;&lt;td&gt;categoria, producto&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Inventario&lt;/td&gt;&lt;td&gt;Express&lt;/td&gt;&lt;td&gt;inventario_db&lt;/td&gt;&lt;td&gt;saldo, movimiento (kardex)&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Compras y Proveedores&lt;/td&gt;&lt;td&gt;Django&lt;/td&gt;&lt;td&gt;compras_db&lt;/td&gt;&lt;td&gt;proveedor, producto_proveedor, orden_compra, orden_detalle, recepcion, recepcion_detalle&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Devoluciones&lt;/td&gt;&lt;td&gt;Flask&lt;/td&gt;&lt;td&gt;devoluciones_db&lt;/td&gt;&lt;td&gt;devolucion, devolucion_detalle&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reportes y Alertas&lt;/td&gt;&lt;td&gt;Flask&lt;/td&gt;&lt;td&gt;reportes_db&lt;/td&gt;&lt;td&gt;alerta (los informes e indicadores se calculan al consultar, no se guardan)&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;API Gateway&lt;/td&gt;&lt;td&gt;Express&lt;/td&gt;&lt;td colspan=&quot;3&quot;&gt;Sin base de datos (valida el JWT y enruta)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="290" width="1500" x="20" y="90" as="geometry" />
        </mxCell>
        <mxCell id="gen_t4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#9673a6;fillColor=#ffffff;spacing=8;fontSize=12;" value="&lt;b&gt;Referencias entre servicios&lt;/b&gt; (solo identificadores: ninguna llave foránea cruza bases de datos)&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th align=&quot;left&quot;&gt;Identificador&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Se guarda en&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Pertenece a&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Cómo se valida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;producto_id&lt;/td&gt;&lt;td&gt;Inventario (saldo, movimiento), Compras (producto_proveedor, orden_detalle), Devoluciones (devolucion_detalle), Reportes (alerta)&lt;/td&gt;&lt;td&gt;Catálogo&lt;/td&gt;&lt;td&gt;Inventario y Compras llaman a Catálogo (&quot;valida producto / productos&quot;); en la alerta lo envía Inventario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;bodega_id&lt;/td&gt;&lt;td&gt;Inventario, Compras (bodega_destino_id), Devoluciones, Reportes (alerta)&lt;/td&gt;&lt;td&gt;Bodegas&lt;/td&gt;&lt;td&gt;Inventario llama a Bodegas (&quot;valida bodega&quot;) al recibir el movimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;proveedor_id&lt;/td&gt;&lt;td&gt;Devoluciones; Catálogo (proveedor_principal_id, solo informativo)&lt;/td&gt;&lt;td&gt;Compras&lt;/td&gt;&lt;td&gt;Sin validación en línea; es un dato informativo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;usuario_id&lt;/td&gt;&lt;td&gt;Inventario (movimiento), Compras (usuario_registrador_id, usuario_receptor_id), Devoluciones, Reportes (alerta: usuario_atencion_id)&lt;/td&gt;&lt;td&gt;Usuarios&lt;/td&gt;&lt;td&gt;Viene dentro del JWT que valida el Gateway; no se consulta&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="215" width="1500" x="20" y="400" as="geometry" />
        </mxCell>
        <mxCell id="gen_t5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;Decisiones del modelo&lt;/b&gt;&lt;br&gt;1. Identidad y roles de usuario se administran en Usuarios; el Gateway aplica la regla &quot;rol → rutas permitidas&quot; y cada servicio la revalida.&lt;br&gt;2. La relación proveedor ↔ producto vive en Compras (producto_proveedor). Catálogo solo guarda una referencia informativa.&lt;br&gt;3. Las existencias las responde Inventario; Bodegas administra las bodegas y sus ubicaciones físicas.&lt;br&gt;4. El Gateway no tiene base de datos. Todas las bases son MySQL, cada una con su volumen persistente.&lt;br&gt;5. Reportes y Alertas guarda solo las alertas; los informes e indicadores se calculan al consultar, pidiendo los datos por API a Inventario y Catálogo." vertex="1">
          <mxGeometry height="140" width="1500" x="20" y="640" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
